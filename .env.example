# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@lotusflare.com
ATLASSIAN_API_TOKEN=your_api_token_here
ATLASSIAN_SITE=lotusflare.atlassian.net

# Zoho People (optional — for employee / department mapping)
# Create Server-based app: https://api-console.zoho.com/
# Redirect URI: http://localhost:8080/oauth/callback
# Run: npm run zoho:auth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PEOPLE_URL=https://people.zoho.com

# Site password (optional locally — hash only, not the plain password)
# Generate: npm run access:hash -- your-password
# VITE_ACCESS_PASSWORD_HASH=

# Jira remind tracking (optional) — Cloudflare Worker; see DEPLOY.md
# Same value as Worker secret REMIND_API_SECRET
# VITE_REMIND_TRACK_URL=https://lf-catalog-remind-track.<your-subdomain>.workers.dev
# VITE_REMIND_API_KEY=

# Local Worker dev (worker/remind-track/.dev.vars — copy from .dev.vars.example)

# Slack user export (optional) — npm run slack:export-users / monthly GitHub Action
# Needs Bot Token Scope: users:read (reinstall app after adding).
# Local: SLACK_BOT_TOKEN=xoxb-…
# CI: repository secret SLACK_BOT_TOKEN
# SLACK_BOT_TOKEN=xoxb-…
