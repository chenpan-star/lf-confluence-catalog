{
  "name": "lf-confluence-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-404.js",
    "preview": "vite preview",
    "test:e2e": "node scripts/e2e-smoke.js",
    "test:e2e:extended": "node scripts/e2e-extended.js",
    "test:remind": "node scripts/test-remind-flow.mjs",
    "test": "npm run build && npm run test:e2e:extended && npm run test:remind",
    "fetch": "node scripts/fetch-confluence.js",
    "generate": "node scripts/generate-catalog.js",
    "refresh": "node scripts/refresh-catalog.js",
    "refresh:offline": "node scripts/refresh-catalog.js --offline",
    "test:auth": "node scripts/test-confluence-auth.js",
    "access:hash": "node scripts/hash-access-password.js",
    "zoho:auth": "node scripts/zoho-oauth-setup.js",
    "zoho:test": "node scripts/test-zoho.js",
    "zoho:fetch": "node scripts/fetch-zoho-people.js",
    "slack:export-users": "node scripts/export-slack-users.js",
    "slack:verify-dm": "node scripts/verify-remind-slack-delivery.mjs",
    "jira:verify-email": "node scripts/verify-jira-prot-email.mjs",
    "jira:test-notify": "node scripts/test-jira-notify.mjs",
    "worker:remind:dev": "wrangler dev --config worker/remind-track/wrangler.jsonc",
    "worker:remind:deploy": "wrangler deploy --config worker/remind-track/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "wrangler": "^4.28.0"
  }
}
